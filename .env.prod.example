# 이 파일을 복사해 Render 환경변수에 등록하세요
# 로컬 개발은 backend/.env 를 사용합니다

# Database — Supabase 프로젝트 Settings > Database > Connection string (URI) 에서 복사
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Redis — Upstash 콘솔 > Redis > Details > REDIS_URL 에서 복사
REDIS_URL=rediss://default:[password]@[host].upstash.io:6379

# Backend
PORT=3001

# CORS — Cloudflare Pages 배포 후 실제 URL로 변경
CORS_ORIGIN=https://your-project.pages.dev

# TossPayments — 개발자센터 > 내 상점 > API 키
TOSSPAYMENTS_SECRET_KEY=test_sk_여기에_시크릿키_입력

# 관리자 상품 등록 이미지 업로드 — Supabase 프로젝트 Settings > API 에서 확인
# Storage 버킷은 대시보드에서 미리 생성 필요(public 버킷 권장)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_키_입력
SUPABASE_STORAGE_BUCKET=product-images
