DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=commerce
DB_PASSWORD=commerce_local_pw
DB_DATABASE=commerce_core
PORT=3001
REDIS_HOST=localhost
REDIS_PORT=6379
ADMIN_TOKEN=your_admin_token_here
CORS_ORIGIN=http://localhost:5173
# Rate limiting (선택, 미설정 시 기본값 100회/60000ms). 부하테스트 시에만 일시적으로 상향.
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
# DB 커넥션 풀 최대 크기 (선택, 미설정 시 기본값 10)
DB_POOL_MAX=10
# 관리자 상품 등록 이미지 업로드 (선택, 미설정 시 이미지 업로드만 실패 — 나머지 기능은 정상 동작)
# Supabase 프로젝트 Settings > API 에서 확인. Storage 버킷은 대시보드에서 미리 생성 필요(public 버킷 권장).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=product-images
