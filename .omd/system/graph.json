{
  "$schema": "https://oh-my-design.kr/schema/design-system-graph-v2.schema.json",
  "components_states": {
    "components": [
      {
        "anatomy": [
          "레이블"
        ],
        "id": "button",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "applicable"
            },
            "error": {
              "applicability": "not-applicable",
              "reason": "버튼 자체는 오류 상태를 갖지 않고 폼 필드가 오류를 표시한다"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "applicable"
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "제출 버튼은 별도 로딩 스피너 없이 비활성으로 처리한다"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "성공은 상위 화면 메시지(예: 장바구니 담김)로 표현한다"
            }
          }
        },
        "semantics": "주요 행동 버튼. 아웃라인 기본형은 1px 잉크 테두리이며 호버 시 잉크 배경으로 반전되고, filled는 잉크 배경에 흰 대문자 레이블이다. 라운드는 0px.",
        "states": [
          "default",
          "hover",
          "focus-visible",
          "disabled"
        ],
        "token_refs": [
          "color.ink",
          "color.on-ink",
          "tracking.label",
          "radius.none",
          "motion.base"
        ],
        "variants": [
          "outline(기본)",
          "filled",
          "small"
        ]
      },
      {
        "anatomy": [
          "옵션 값 레이블"
        ],
        "id": "option-chip",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "applicable"
            },
            "error": {
              "applicability": "not-applicable",
              "reason": "선택 오류는 담기 버튼 비활성으로 방지한다"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "applicable"
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "옵션 칩은 즉시 렌더되어 로딩 상태가 없다"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "선택 성공은 반전 상태로 표현한다"
            }
          }
        },
        "semantics": "상품 상세의 사이즈·색상 선택 칩. 선택(selected) 시 잉크 배경으로 반전되고, 품절 옵션은 disabled + 취소선으로 표시한다.",
        "states": [
          "default",
          "hover",
          "focus-visible",
          "disabled"
        ],
        "token_refs": [
          "color.ink",
          "color.hairline",
          "color.on-ink",
          "radius.none"
        ],
        "variants": [
          "selected(잉크 반전)"
        ]
      },
      {
        "anatomy": [
          "3:4 이미지",
          "카테고리(대문자)",
          "상품명",
          "가격"
        ],
        "id": "product-card",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "not-applicable",
              "reason": "상품 카드에는 비활성 상태가 없다"
            },
            "error": {
              "applicability": "not-applicable",
              "reason": "로드 실패는 이미지 배경(#f0f0f0)이 유지된다"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "applicable"
            },
            "loading": {
              "applicability": "applicable"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "카드는 성공 상태를 갖지 않는다"
            }
          }
        },
        "semantics": "상품 목록 타일. 3:4 이미지가 주인공이며 호버 시 이미지가 1.04배 확대되고, 캡션은 대문자 카테고리·상품명·가격 순으로 아래에 놓인다. 테두리·그림자·라운드 없음.",
        "states": [
          "default",
          "hover",
          "focus-visible",
          "loading"
        ],
        "token_refs": [
          "color.image-surface",
          "text.base-size",
          "tracking.label",
          "motion.image",
          "radius.none"
        ],
        "variants": []
      },
      {
        "anatomy": [
          "라벨(대문자)",
          "입력 필드"
        ],
        "id": "text-input",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "not-applicable",
              "reason": "입력 필드에는 비활성 스타일이 정의되어 있지 않다"
            },
            "error": {
              "applicability": "applicable"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "not-applicable",
              "reason": "입력 필드는 별도 호버 스타일 없이 포커스로 상태를 표현한다"
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "입력은 로딩 상태를 갖지 않는다"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "성공은 화면 단위 메시지로 표현한다"
            }
          }
        },
        "semantics": "폼 입력. 스토어프론트는 밑줄(border-bottom)만 쓰고 포커스 시 잉크로 진해지며, 관리자 입력은 1px 테두리 + 4px 라운드다. 오류는 필드 아래 붉은 텍스트로 안내한다.",
        "states": [
          "default",
          "focus-visible",
          "error"
        ],
        "token_refs": [
          "color.hairline",
          "color.ink",
          "color.error",
          "radius.input",
          "radius.none"
        ],
        "variants": [
          "underline(스토어프론트)",
          "bordered(관리자)"
        ]
      },
      {
        "anatomy": [
          "페이지 번호"
        ],
        "id": "pagination-button",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "applicable"
            },
            "error": {
              "applicability": "not-applicable",
              "reason": "버튼은 오류 상태를 갖지 않는다"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "applicable"
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "페이지 전환은 목록 refetch로 처리되어 버튼 자체 로딩은 없다"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "버튼은 성공 상태를 갖지 않는다"
            }
          }
        },
        "semantics": "목록 페이지네이션 버튼. 현재 페이지는 잉크 반전으로 강조하고, 처음/끝에서는 비활성 처리한다.",
        "states": [
          "default",
          "hover",
          "focus-visible",
          "disabled"
        ],
        "token_refs": [
          "color.ink",
          "color.hairline",
          "color.canvas",
          "radius.none"
        ],
        "variants": [
          "active(잉크 반전)"
        ]
      },
      {
        "anatomy": [
          "상태 텍스트"
        ],
        "id": "order-status-badge",
        "interaction": {
          "kind": "non-interactive",
          "reason": "상태를 표시만 하는 정적 라벨이라 상호작용 상태가 없다"
        },
        "semantics": "주문 상태를 표시만 하는 비상호작용 라벨. 5개 상태별로 옅은 배경 + 진한 글자 쌍을 쓰고 2px 라운드다.",
        "states": [
          "default"
        ],
        "token_refs": [
          "color.status.pending.bg",
          "color.status.paid.bg",
          "color.status.shipped.bg",
          "color.status.delivered.bg",
          "color.status.cancelled.bg",
          "radius.badge"
        ],
        "variants": [
          "pending",
          "paid",
          "shipped",
          "delivered",
          "cancelled"
        ]
      }
    ],
    "rules": [
      "인터랙티브 요소는 default/hover/focus-visible/disabled를 기본으로 정의한다",
      "선택·활성 상태는 잉크 반전(잉크 배경 + 흰 글자)으로 일관되게 표현한다",
      "전이는 0.15–0.2s로 짧게, 상품 이미지 확대만 0.5s를 쓴다"
    ]
  },
  "content_locales": {
    "locales": [
      {
        "locale": "ko",
        "rules": [
          "기본 로케일",
          "본문은 Noto Sans KR로 렌더한다"
        ],
        "status": "supported"
      }
    ],
    "terminology": {
      "배송 타임라인": "배송 단계(수거→간선상차→배송출발→배송완료)",
      "장바구니": "장바구니(카트로 표기하지 않는다)",
      "주문 조회": "주문 조회(게스트) / 마이페이지(로그인)"
    },
    "voice": [
      "간결하고 사실적인 한국어를 쓰고, 카테고리·라벨은 명사 위주로 표기한다",
      "상태·오류 메시지는 무엇이 필요한지 구체적으로 안내한다(예: 유효한 이메일을 입력하세요)",
      "느낌표나 과장 없이 담백하게 쓴다"
    ]
  },
  "experience": {
    "avoid": [
      "브랜드 컬러 액센트나 그라데이션으로 상품 이미지와 경쟁하지 않는다",
      "스토어프론트 인터랙티브 요소에 라운드를 넣지 않는다(관리자 대시보드는 예외)",
      "긴급성을 유도하는 배지나 과장된 문구를 쓰지 않는다"
    ],
    "design_direction": [
      "무채색 모노크롬: 잉크(#1e1e1e)와 캔버스(흰색)를 주 색으로 삼아 상품 이미지가 유일한 채도가 되게 한다",
      "스토어프론트는 0px 라운드의 에디토리얼 플랫 미학, 관리자 대시보드는 4–10px 소프트 라운드로 도구적 밀도를 확보한다",
      "대문자 마이크로 라벨(11–12px, 자간 0.08–0.15em)로 카테고리·폼 라벨·상태를 표기한다",
      "그림자는 거의 쓰지 않고 1px 헤어라인 경계로 깊이를 표현한다"
    ],
    "primary_tasks": [
      "상품을 카테고리·검색·이미지 유사도로 탐색하고 상세 옵션(사이즈·색상)과 재고를 확인한다",
      "장바구니에 담아 재고를 확인한 뒤 게스트 또는 로그인 상태로 주문·결제한다",
      "주문번호와 이메일로 주문을 조회하거나 마이페이지에서 배송 타임라인을 추적한다",
      "관리자는 재고·주문·배송을 관리하고 매출·판매 통계를 확인한다"
    ],
    "principles": [
      "상품이 주인공이다: UI는 상품 사진을 담는 프레임이며 장식을 최소화한다",
      "절제가 곧 고급감이다: 본문 400과 강조 600–700 두 축의 굵기와 좁은 색 팔레트를 유지한다",
      "한국어 우선: 본문은 Noto Sans KR로 읽히고 라틴 라벨은 대문자로 표기한다"
    ],
    "summary": "Commerce Core는 프로덕션 품질을 지향하는 이커머스 포트폴리오로, 신발·상의·하의 패션 카탈로그를 파는 B2C 스토어프론트와 재고·주문·배송·통계를 다루는 관리자 대시보드로 구성된다."
  },
  "foundations": {
    "contrast_pairs": [
      {
        "background": "color.canvas",
        "foreground": "color.ink",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.ink",
        "foreground": "color.on-ink",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.canvas",
        "foreground": "color.muted",
        "minimum_ratio": 4.5
      }
    ],
    "reduced_motion": true,
    "rules": [
      "색 팔레트는 무채색 잉크/캔버스/헤어라인이 기본이며, 유채색은 주문 상태 배지와 관리자 알림 등 의미 전달에만 제한적으로 쓴다",
      "라운드는 스토어프론트 0px, 관리자 대시보드 4–10px로 화면 성격에 따라 분리한다",
      "깊이는 그림자 대신 1px 헤어라인 경계로 표현한다(모바일 헤더 드롭다운만 예외적으로 옅은 그림자 사용)",
      "대문자 라틴 라벨에는 0.08–0.15em 자간을 준다"
    ],
    "tokens": {
      "color.alert-bg": {
        "$description": "재고 부족 배너 배경",
        "$type": "color",
        "$value": "#fdf6e3"
      },
      "color.alert-border": {
        "$description": "재고 부족 배너 경계",
        "$type": "color",
        "$value": "#f0c36d"
      },
      "color.alert-fg": {
        "$description": "재고 부족 배너 텍스트",
        "$type": "color",
        "$value": "#7a5b00"
      },
      "color.canvas": {
        "$description": "페이지 캔버스",
        "$type": "color",
        "$value": "#ffffff"
      },
      "color.danger": {
        "$description": "관리자 위험 액션(취소 등)",
        "$type": "color",
        "$value": "#dc2626"
      },
      "color.error": {
        "$description": "폼/재고 오류 텍스트",
        "$type": "color",
        "$value": "#c0392b"
      },
      "color.hairline": {
        "$description": "1px 헤어라인 경계선",
        "$type": "color",
        "$value": "#dfdfdf"
      },
      "color.image-surface": {
        "$description": "상품 이미지 로드 전 배경",
        "$type": "color",
        "$value": "#f0f0f0"
      },
      "color.ink": {
        "$description": "본문·아이콘·경계 등 주 색(잉크)",
        "$type": "color",
        "$value": "#1e1e1e"
      },
      "color.live": {
        "$description": "SSE 실시간 연결 표시 점",
        "$type": "color",
        "$value": "#22c55e"
      },
      "color.low-stock": {
        "$description": "재고 부족 강조",
        "$type": "color",
        "$value": "#b7791f"
      },
      "color.muted": {
        "$description": "보조/설명 텍스트",
        "$type": "color",
        "$value": "#757575"
      },
      "color.on-ink": {
        "$description": "잉크 배경 위 텍스트",
        "$type": "color",
        "$value": "#ffffff"
      },
      "color.role-admin": {
        "$description": "관리자 role 배지",
        "$type": "color",
        "$value": "#2a78d6"
      },
      "color.status.cancelled.bg": {
        "$type": "color",
        "$value": "#fee2e2"
      },
      "color.status.cancelled.fg": {
        "$type": "color",
        "$value": "#991b1b"
      },
      "color.status.delivered.bg": {
        "$type": "color",
        "$value": "#d1fae5"
      },
      "color.status.delivered.fg": {
        "$type": "color",
        "$value": "#065f46"
      },
      "color.status.paid.bg": {
        "$type": "color",
        "$value": "#dbeafe"
      },
      "color.status.paid.fg": {
        "$type": "color",
        "$value": "#1e40af"
      },
      "color.status.pending.bg": {
        "$type": "color",
        "$value": "#fef3c7"
      },
      "color.status.pending.fg": {
        "$type": "color",
        "$value": "#92400e"
      },
      "color.status.shipped.bg": {
        "$type": "color",
        "$value": "#ede9fe"
      },
      "color.status.shipped.fg": {
        "$type": "color",
        "$value": "#5b21b6"
      },
      "font.sans": {
        "$description": "한국어는 Noto Sans KR",
        "$type": "fontFamily",
        "$value": "'Helvetica Neue', 'Noto Sans KR', Arial, sans-serif"
      },
      "motion.base": {
        "$type": "duration",
        "$value": "0.2s"
      },
      "motion.fast": {
        "$type": "duration",
        "$value": "0.15s"
      },
      "motion.image": {
        "$description": "상품 이미지 확대 전이",
        "$type": "duration",
        "$value": "0.5s"
      },
      "radius.badge": {
        "$description": "주문 상태 배지",
        "$type": "dimension",
        "$value": "2px"
      },
      "radius.banner": {
        "$description": "재고 부족 배너",
        "$type": "dimension",
        "$value": "8px"
      },
      "radius.card": {
        "$description": "관리자 통계 카드/KPI 타일",
        "$type": "dimension",
        "$value": "10px"
      },
      "radius.control": {
        "$description": "관리자 네비/토글",
        "$type": "dimension",
        "$value": "6px"
      },
      "radius.input": {
        "$description": "관리자 입력/검색",
        "$type": "dimension",
        "$value": "4px"
      },
      "radius.none": {
        "$description": "스토어프론트 버튼·입력·카드(에디토리얼 플랫)",
        "$type": "dimension",
        "$value": "0"
      },
      "shadow.menu": {
        "$description": "모바일 헤더 드롭다운 한정",
        "$type": "shadow",
        "$value": "0 10px 16px rgba(0, 0, 0, 0.05)"
      },
      "shadow.none": {
